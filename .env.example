# Aegis GI — Outcome-Verified Healthcare Agent
# Production Environment Variables Configuration Template

# ==============================================================================
# 1. CORE SERVICE CONFIGURATION
# ==============================================================================
PROJECT_NAME="Outcome-Verified GI Prep & Booking Agent"
VERSION="1.0.0"
ENVIRONMENT="production"        # "development" | "staging" | "production"
LOG_LEVEL="INFO"                # "DEBUG" | "INFO" | "WARNING" | "ERROR"

# ==============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ==============================================================================
# Neon / Supabase async connection string:
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?ssl=require
DATABASE_URL="postgresql+asyncpg://neondb_owner:npg_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?ssl=require"
USE_PGVECTOR="true"

# Local SQLite fallback for testing (default if DATABASE_URL is unset):
# DATABASE_URL="sqlite+aiosqlite:///./data/clinical_ehr.db"

# ==============================================================================
# 3. LLM INFERENCE (Google Gemini API)
# ==============================================================================
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"
LLM_PROVIDER="gemini"           # "gemini" | "auto"

# Optional LangSmith observability tracing
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="gi-prep-booking-agent"

# ==============================================================================
# 4. AUTHENTICATION & JWT SECURITY
# ==============================================================================
# Generate a strong 64-char random hex key: `openssl rand -hex 32`
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-secret-key-in-production"
ALGORITHM="HS256"

# ==============================================================================
# 5. FRONTEND CONFIGURATION (Vercel / Next.js)
# ==============================================================================
# Public backend API URL exposed to frontend client
# Local development: http://localhost:8000
# Production Render/Cloud Run: https://aegis-gi-backend.onrender.com
NEXT_PUBLIC_API_URL="https://aegis-gi-backend.onrender.com"
